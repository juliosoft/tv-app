<Window x:Class="TvApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="TvApp - IPTV Player" Height="720" Width="1200" MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        Background="#1B1F27"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopBarRow" Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid Grid.Row="0" Background="#20242E" x:Name="TopBarGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding AccountLabel}" Foreground="#8A94A6"
                       VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"/>

            <TextBox Grid.Column="1" x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#262B36" Foreground="White" BorderBrush="#3A4150"
                     VerticalContentAlignment="Center" Padding="8,4"
                     Margin="24,10" MaxWidth="420" HorizontalAlignment="Stretch"
                     ToolTip="Buscar canal pelo nome..."/>

            <Button Grid.Column="2" Content="&#8635; Atualizar" Command="{Binding RefreshCommand}"
                    Style="{StaticResource IconButton}" Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="Sair da conta" Command="{Binding LogoutCommand}"
                    Style="{StaticResource IconButton}" Margin="0,0,16,0"/>
        </Grid>

        <!-- Conteudo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoriesColumn" Width="230"/>
                <ColumnDefinition x:Name="ChannelsColumn" Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Grupos / categorias -->
            <Border Grid.Column="0" Background="#20242E" BorderBrush="#2E3340" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="GRUPOS" Foreground="#5A6272" FontSize="11"
                               FontWeight="Bold" Margin="14,12,0,6"/>
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             DisplayMemberPath="CategoryName"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarListBoxItem}"/>
                </DockPanel>
            </Border>

            <!-- Lista de canais -->
            <Border Grid.Column="1" Background="#1E222B" BorderBrush="#2E3340" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Foreground="#5A6272" FontSize="11"
                               FontWeight="Bold" Margin="14,12,0,6"
                               Text="{Binding SelectedCategory.CategoryName, StringFormat='CANAIS - {0}'}"/>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding IsLoading, Converter={StaticResource BoolToLoadingTextConverter}}"
                               Foreground="#8A94A6" Margin="14,0,0,6" FontStyle="Italic"/>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#FF6B6B"
                               TextWrapping="Wrap" Margin="14,0,14,8"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <ListBox x:Name="ChannelsListBox"
                             ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                             MouseDoubleClick="ChannelsListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="&#9733;"
                                            Style="{StaticResource IconButton}"
                                            Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteToBrushConverter}}"
                                            FontSize="16" Padding="4"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>

                                    <Image Grid.Column="1" Source="{Binding StreamIcon}" Width="26" Height="26"
                                           Stretch="Uniform" Margin="4,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="White"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Player -->
            <Grid Grid.Column="2" Background="Black">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <vlc:VideoView Grid.Row="0" x:Name="VideoViewControl" MediaPlayer="{Binding MediaPlayer}"/>

                <TextBlock Grid.Row="0" Text="Selecione um canal na lista e de dois cliques para reproduzir"
                           Foreground="#5A6272" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NowPlaying, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}"/>

                <Grid Grid.Row="1" Background="#181B22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding NowPlayingLabel}" Foreground="#C8CDD6"
                               VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="1" Content="&#9632; Parar" Command="{Binding StopCommand}"
                            Style="{StaticResource IconButton}" Margin="4,0"/>

                    <Button Grid.Column="2" Content="&#128266;" x:Name="MuteButton"
                            Command="{Binding ToggleMuteCommand}"
                            Style="{StaticResource IconButton}" Margin="4,0"/>

                    <Slider Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding Volume}"
                            VerticalAlignment="Center" Margin="4,0"/>

                    <Button Grid.Column="4" Content="&#9974; Tela cheia" x:Name="FullscreenButton"
                            Click="FullscreenButton_Click"
                            Style="{StaticResource IconButton}" Margin="4,0,16,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
